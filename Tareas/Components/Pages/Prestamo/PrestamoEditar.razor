@page "/Prestamo/Consultar/{id:int}"
@rendermode InteractiveServer

<div class="container text-center">
    <h4>Modo de Edicion</h4>
    @*Formulario de Editar Estudiate *@
    <div class="card border-3" style="width:400px ; margin:auto ; height:250px">

        <div>
            <label>IdEstudiante</label>
            <br />
            <input type="text" @bind="prestamoEditar.IdEstudiante" />
        </div>

        <div>
            <label>IDLibro</label>
            <br />
            <input type="text" @bind="prestamoEditar.IdLibro" />
        </div>

        <div>
            <label>Fecha de Prestamo</label>
            <br />
            <input type="text" @bind="prestamoEditar.FechaDePrestamo" />
        </div>

        <h6 style="color:forestgreen">@MensajeError</h6>
        @*Botones *@
        <div>
            <button class="btn btn-warning " style="width:100px" @onclick="Pagina">Consultar </button>
            <button class="bnt btn-primary" style="width:100px" @onclick=" GuardarEditar">Guardar</button>
        </div>
    </div>
</div>
@code {
    public List<Prestamo> prestamos { get; set; } = [];
    public Prestamo prestamoEditar = new();
    [Parameter]
    public int id{ get; set; }
    public string MensajeError { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Editar(id);
    }
    public async Task Editar(int id)
    {
        var Prestamo = await prestamoservice.Buscar(id);
        if (Prestamo != null)
        {
            prestamoEditar = Prestamo;
        }
    }

    public async Task GuardarEditar()
    {
        await prestamoservice.Editar(prestamoEditar);
        prestamos = await prestamoservice.GetList(L => true);
        MensajeError = "Modificado Correctamente";
    }

    public void Pagina()
    {
        NavegacionPagina.NavigateTo("Prestamo/Consultar");
    }
}
