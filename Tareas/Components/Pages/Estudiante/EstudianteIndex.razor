@page "/Estudiante/Consulta"
@rendermode InteractiveServer

<PageTitle>Consultar Estudiante</PageTitle>

<div class="container">
    <div class="card border-4">
        <div>
            <h4 class="text-center">Consultar Estudiante</h4>
        </div>
        <div class="card border-4">
            <div>
                <label>Filtrar</label>
                <select style="width:75px;"@bind="filtar">
                    <option>ID</option>
                    <option>Nombre</option>
                    <option>Direccion</option>
                    <option>Email</option>
                </select>
                <label>Busquedad</label>
                <input class="text"@bind="ValorFiltar"/>
                <button class="btn btn-primary" style="margin-left:350px"@onclick="Filtrar">Buscar</button>
            </div>
        </div>
        <table class="table table-bordered">
            <thead>
               <tr>
                   <th>Id</th>
                    <th>Nombre</th>
                    <th>Dirrecion</th>
                    <th>Email</th>
                    <th>Fecha de Nacimiento</th>
               </tr>
            </thead>
            <tbody>
                @foreach(var Estudiante in estudiantes)
                {
                    <tr>
                        <th>@Estudiante.EstudianteId</th>
                        <th>@Estudiante.Nombre</th>
                        <th>@Estudiante.Dirrecion</th>
                        <th>@Estudiante.Email</th>
                        <th>@Estudiante.FechaNacimiento</th>
                        <butto class="btn btn-warning" @onclick="EliminarEstudiante">Eliminar</butto>
                        <butto class="btn btn-danger" @onclick="()=>PaginaEditar(Estudiante.EstudianteId)">Editar</butto>
                    </tr>
                }
            </tbody>
        </table>
        <div>
            
        </div>
    </div>
</div>

@code{

    public List<Estudiante> estudiantes = [];
    public string filtar { get; set; } = string.Empty;
    public string ValorFiltar { get; set; } = string.Empty;
    public int IdEliminar{ get; set; }


    protected override async Task OnInitializedAsync()
    {
        var Result = await estudianteService.GetList(E => true);
        if (Result.IsSuccess)
        {
            estudiantes = Result.Value!;
        }
    }

    public async Task Filtrar()
    {

        if (ValorFiltar.Trim() != "")
        {
            if (filtar == "ID")
            {
                if (int.TryParse(ValorFiltar, out int id))
                {
                    var resultado = await estudianteService.GetList( L => L.EstudianteId == id);
                    estudiantes = resultado.Value;
                }
            }
             if (filtar == "Nombre")
            {
                var resultado = await estudianteService.GetList(  L => L.Nombre.Contains(ValorFiltar));
                estudiantes = resultado.Value;
            }
            if (filtar == "Direccion")
            {
                var resultado = await estudianteService.GetList( L => L.Dirrecion.Contains(ValorFiltar));
                estudiantes = resultado.Value;
            }
            else if (filtar == "Email")
            {
                var resultado = await estudianteService.GetList(L => L.Email.Contains(ValorFiltar));
                estudiantes = resultado.Value;
            }
        }

    }
    public async Task EliminarEstudiante()
    {
        await estudianteService.Eliminar(IdEliminar);
        var resultado = await estudianteService.GetList(D => true);
        estudiantes = resultado.Value;

    }
    public void PaginaEditar(int id)
    {
        navegation.NavigateTo($"/Editar/{id}");

    }
}