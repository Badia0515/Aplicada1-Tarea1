@page "/Devolucion/{id:int}"
@rendermode InteractiveServer
@*Panel*@
<div class="container">
    <h4 style="text-center">Registro de Devolucion</h4>
    <div class="card border-3 p-3" style="height:400px">
        @*Formulacion con las validaciones*@
        <EditForm Model="devolucionEditar" OnValidSubmit="GuardarEditar" FormName="Editar">
            <DataAnnotationsValidator />
            <div class="mb-4">
                <label>Id Prestamo</label>
                <br />
                <InputNumber @bind-Value="devolucionEditar.IdPrestamo" class="form-control" />
                <ValidationMessage class="text-danger" For="@(() => devolucionEditar.IdPrestamo)" />
            </div>

            <div class="mb-4">
                <label>Libro</label>
                <br />
                <InputText @bind-Value="devolucionEditar.Libro" class="form-control" />
                <ValidationMessage class="text-danger" For="@(() => devolucionEditar.Libro)" />
            </div>

            <div class="mb-4">
                <label>Fecha Devolucion</label>
                <br />
                <InputDate @bind-Value="devolucionEditar.FechaDevolucion" class="form-control" />
                <ValidationMessage class="text-danger" For="@(() => devolucionEditar.FechaDevolucion)" />
            </div>
            @*Los botones *@
            <div class="d-flex justify-content-center gap-3 mb-4">
                <button type="button" class="btn btn-warning bi bi-journal-album" @onclick="Pagina">Consultar</button>
                <button type="submit" class="btn btn-primary bi bi-floppy">Guardar</button>
            </div>
        </EditForm>
    </div>
</div>
@code {
    public List<Devolucion> devolucion { get; set; } = [];
    public Devolucion devolucionEditar { get; set; } = new();

    [Parameter]
    public int id{ get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Edita(id);
    }
    public async Task Edita(int id)
    {
        var Resultado = await devolucionService.Buscar(id);
        if (Resultado.Value != null)
        {
            devolucionEditar = Resultado.Value;
        }
    }
    public async Task GuardarEditar()
    {
        await devolucionService.Editar(devolucionEditar);
        var resultado= await devolucionService.GetList(D => true);
        devolucion = resultado.Value;
    }
    public void Pagina()
    {
        navegation.NavigateTo("/Devolucion/Consultar");
    }
}
