@page "/Devolucion/Registro"
@rendermode InteractiveServer
@*Panel*@
<div class="container">
  <h4 style="text-center">Registro de Devolucion</h4>
    <div class="card border-3 p-3" style="height:400px">
        @*Formulacion con las validaciones*@
        <EditForm Model="devolucion" OnValidSubmit="Guardar" FormName="Registro">
            <DataAnnotationsValidator/>

            <div class="mb-4">
                <label>Id Prestamo</label>
                <br />
                <InputNumber @bind-Value="devolucion.IdPrestamo" class="form-control" />
                <ValidationMessage class="text-danger" For="@(()=>devolucion.IdPrestamo)" />
            </div > 
            
            <div class="mb-4">
                <label>Libro</label>
                <br />
                <InputText @bind-Value="devolucion.Libro" class="form-control"/>
                <ValidationMessage class="text-danger" For="@(() => devolucion.Libro)" />
            </div>

            <div class="mb-4">
                <label>Fecha Devolucion</label>
                <br />
                <InputDate @bind-Value="devolucion.FechaDevolucion" class="form-control" />
                <ValidationMessage class="text-danger" For="@(() => devolucion.FechaDevolucion)" />
            </div>
            @*Los botones *@
            <div class="d-flex justify-content-center gap-3 mb-4">
                <button type="button" class="btn btn-warning bi bi-journal-album" @onclick="Pagina">Consultar</button>
                <button type="submit" class="btn btn-primary bi bi-floppy">Guardar</button>
               
            </div>

        </EditForm>

    </div>

</div>

@code {
    public Devolucion devolucion { get; set; } = new();
    public String Mensaje { get; set; } = string.Empty;

    public async Task Guardar()
    {
        var Existe = await devolucionService.GetList(D => D.IdPrestamo == devolucion.IdPrestamo);
        if(Existe.Count>0)
        {
            Mensaje = "El prestamo ya fue devolvido";
        }
        else
        {
            await devolucionService.Guardar(devolucion);
        }

    }
    public void Pagina()
    {
        navegation.NavigateTo("/Devolucion/Consultar");
    }
}
