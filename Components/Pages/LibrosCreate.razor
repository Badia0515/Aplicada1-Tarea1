@page "/counter"
@page "/Registro/{id:int}"
@rendermode InteractiveServer
@using Tarea1.Models
@using Tarea1.Service
@inject LibrosService librosService
@inject NavigationManager Navegacion



<PageTitle>Formulario de Libros</PageTitle>

<div class="container">
    <h1 class="text-center">Registro de Libros</h1>
    <div class="card-header">
        <div class="card border-4" style="width:500px; margin:auto">
            <div class="text-center ">
                <label class="text-center">Complete los siguientes datos</label>
                <br/>
               
                <label>Titulo</label>
                <br />
                <input class="text" @bind="libros.Titulo" />
                <br />
                <label> Año de Publicacion</label>
                <br />
                <input class="number" @bind="libros.Anio" />
                <br />
                <label>Autor</label>
                <br />
                <input class="text" @bind="libros.Autor" />
                <br />
           

            </div>
            @if(Mensaje != "")
            {
                <h7 class="text-center" style="color:green">@Mensaje</h7>
            }
            else
            {
                <h7 class="text-center" style="color:red">@MensajeError</h7>
            }
          <div style="margin-left:150px">

                <button class="btn btn-success" @onclick="Consultar"> Consultar</button>
                <button class="btn btn-primary" @onclick="Guardar"> Guardar </button>

            
          </div>
          <br />
            

    </div>

    </div>
</div>

@code{


    public Libros libros { get; set; } = new();
    Libros librosEditar { get; set; } = new();
    public string Mensaje= "";
    public string MensajeError= "";

    [Parameter]
    public int id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var lista=await librosService.GetList(L=>L.IdLibro==id);
        if (lista.Count > 0)
        {
            libros = lista.First();
        }

    }

    private async Task Guardar()
    {
        var existe = await librosService.GetList(L => L.Titulo == libros.Titulo);
        if (existe.Count > 0)
        {
            MensajeError = "No se puede Guardar el mismo titulo";
            return;
        }
        await librosService.Guardar(libros);
        Mensaje = "Se Guardo Correctamente";
    }

    private void Consultar()
    {
        Navegacion.NavigateTo("/Libros");
    }
    public async Task Editar(int id)
    {
        var lista = await librosService.GetList(L => L.IdLibro == id);
        librosEditar = lista.First();


    }
}





