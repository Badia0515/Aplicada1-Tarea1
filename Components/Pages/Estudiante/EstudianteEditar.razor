
@page "/Editar/{id:int}"
@rendermode InteractiveServer

<div class="container">
    <div class=" card border-4" style="width:400px; margin:auto; height:240px">
        <div class="text-center">
            <h5>Modo Edicion</h5>
            <label>Nombre</label>
            <input class="text" @bind="estudianteEditar.Nombre" />
            <br />
            <label>Dirrecion</label>
            <input class="text" @bind="estudianteEditar.Dirrecion" />
            <br />
            <label>Email</label>
            <input class="text" @bind="estudianteEditar.Email" />
            <br />
            <label>Fecha de Nacimiento</label>
            <input class="text" @bind="estudianteEditar.FechaNacimiento" />
            <br />
            <button class="btn btn-warning" @onclick="Navegacion">Consultar</button>
            <button class="btn btn-primary" @onclick="EdicionGuardar">Guardar</button>

            
        </div>
    </div>
</div>

@code {
    public List<Estudiante> estudiantes { get; set; } = [];
    public Estudiante estudianteEditar { get; set; } = new();
    [Parameter]
    public int id{ get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Editar(id);


    }

    public async Task Editar(int id)
    {
        var Estudiante = await estudianteService.Buscar(id);
        if(Estudiante != null)
        {
            estudianteEditar = Estudiante;
        }

    }
    public async Task EdicionGuardar()
    {
        await estudianteService.Guardar(estudianteEditar);
        estudiantes = await estudianteService.GetList(L => true);
    }
    public void Navegacion()
    {
        NavegacionPagina.NavigateTo("Estudiante/Consulta");

    }

}
