@page "/Prestamo/Crear"
@rendermode InteractiveServer
<div class="container text-center" >
    <h4>Registro de Prestamo</h4>
    @*Formulario de Registro Estudiate *@
    <div class="card border-3" style="width:400px ; margin:auto ; height:250px" >
        <div>
            <label>IdEstudiante</label>
            <br />
            <input type="text"@bind="prestamo.IdEstudiante"/>
        </div>

        <div>
            <label>IDLibro</label>
            <br />
            <input type="text" @bind="prestamo.IdLibro"/>
        </div>

        <div>
            <label>Fecha de Prestamo</label>
            <br />
            <input type="text" @bind="prestamo.FechaDePrestamo"/>
        </div>
        @*Mensaje de confimacion *@
        <h6 style="color:red">@MensajeError</h6>
        <h6 style="color:forestgreen">@Mensaje</h6>
        <div>
            @*Botones *@
        <button class="btn btn-warning " style="width:100px" @onclick="Pagina">Consultar </button>
            <button class="bnt btn-primary" style="width:100px" @onclick=" Guardar">Guardar</button>
        </div>

    </div>
</div>

@code{

    public Prestamo prestamo { get; set; } = new();
    public string MensajeError { get; set; } = string.Empty;
    public string Mensaje { get; set; } = string.Empty;



    public async Task Guardar()
    {
        var ExisteEstudiante = await estudianteService.GetList(L => L.EstudianteId== prestamo.IdEstudiante);
        var ExisteLibro = await librosService.GetList(L => L.IdLibro== prestamo.IdLibro);
        var existePrestamo = await prestamoservice.GetList(L => L.IdEstudiante == prestamo.IdEstudiante);
        if (ExisteEstudiante.Count == 0)
        {
            MensajeError = "EL Estudiante no esta registrado";
            return;
        }
        if (ExisteLibro.Count == 0)
        {
            MensajeError = "EL Libro no esta registrado";
            return;
        }
        if (existePrestamo.Count > 0)
        {
            MensajeError = "Error: Ya ese estudiante esta registrado";
            return;
        }
        else
        {
            Mensaje = "Prestamo Registrado";
        }
        await prestamoservice.Guardar(prestamo);
    }

    public void Pagina()
    {
        NavegacionPagina.NavigateTo("Prestamo/Consultar");
    }
}
